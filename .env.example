# ==============================================================================
# WorkPulse ESS — ERPNext / Frappe HRMS v15 Configuration
# Copy this file to .env and fill in your real ERPNext server settings.
# Never expose ERPNEXT_API_KEY or ERPNEXT_API_SECRET to client-side code!
# ==============================================================================

# Server runtime port (AI Studio requires 3000)
PORT=3000
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 1. ERPNext / Frappe HRMS v15 Connection
# When SANDBOX_MODE=true (default), the app uses built-in sample data and shows
# test accounts (Tariq employee, Ayesha manager) even if ERPNEXT_URL is set.
# Set SANDBOX_MODE=false and provide ERPNEXT_URL to connect to live ERPNext.
# ------------------------------------------------------------------------------
SANDBOX_MODE="true"
ERPNEXT_URL=""
# Example: ERPNEXT_URL="https://erp.yourcompany.com"

# Optional Service Account API Key/Secret (used ONLY server-side for admin/HR
# file lookups or background operations; employee logins use /api/method/login)
ERPNEXT_API_KEY=""
ERPNEXT_API_SECRET=""

# Signing secret for server-side session cookies (change in production!)
SESSION_SECRET="change-this-to-a-random-32-char-secret"

# ------------------------------------------------------------------------------
# 2. Company Branding & Language
# ------------------------------------------------------------------------------
COMPANY_NAME="Al-Mizan Precision Mfg."
COMPANY_PRIMARY_COLOR="#0F6E52"
COMPANY_LOGO_URL="/src/assets/images/company_logo_mark_1795073428207.jpg"
ENABLE_URDU_OPTION="true"

# ------------------------------------------------------------------------------
# 3. Attendance Security & Geofencing
# JSON array of authorized factory/office geofences [lat, lng, radiusMeters]
# ------------------------------------------------------------------------------
GEOFENCE_ZONES='[{"id":"hq-factory","name":"Main Plant & Head Office","lat":31.5204,"lng":74.3587,"radiusMeters":250},{"id":"warehouse-north","name":"North Logistics Warehouse","lat":31.5497,"lng":74.3436,"radiusMeters":200}]'

# Minimum seconds required between two consecutive punches (default 120 = 2 min)
DOUBLE_PUNCH_GUARD_SECONDS=120

# Auto-logout / session lock after inactivity in minutes (default 15)
INACTIVITY_TIMEOUT_MINUTES=15

# Face verification minimum cosine similarity threshold (0.0 - 1.0)
FACE_MATCH_THRESHOLD=0.72
